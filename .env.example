DATABASE_URL=postgres://matcher:matcher@localhost:5432/matcher?sslmode=disable
PORT=8080
MAX_CVS=500000
# Default worker count for matching (1..64)
MATCHING_WORKERS=4

ALLOWED_IPS=127.0.0.1,::1,192.0.2.10,10.0.0.0/8
ALLOWED_DOMAINS=app.example.com,admin.example.com

# Generate with: go run ./cmd/genapikey
API_KEY=REPLACE_WITH_GENERATED_KEY
